#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        scroll {
            bindings = <&tog 5>;
            key-positions = <20 19>;
        };

        chatgpt {
            bindings = <&kp LA(J)>;
            key-positions = <24 25>;
        };

        command_enter {
            bindings = <&kp LG(ENTER)>;
            key-positions = <26 25>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <3 4>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                   &kp W    &kp E           &kp R           &kp T                                               &kp Y             &kp U            &kp I            &kp O    &kp P
&kp A                   &kp S    &mt LEFT_ALT D  &mt LEFT_GUI F  &mt LCTRL G       &tog 5             &kp LG(LA(I))  &mt RCTRL H       &mt RIGHT_GUI J  &mt RIGHT_ALT K  &kp L    &kp MINUS
&mt LEFT_SHIFT Z        &kp X    &kp C           &kp V           &kp B             &kp BACKSPACE      &kp LC(UP)     &kp N             &kp M            &kp COMMA        &kp DOT  &mt LEFT_SHIFT SLASH
&mt LEFT_CONTROL LG(C)  &kp TAB  &kp LG(V)       &kp BACKSPACE   &lt 1 LANGUAGE_2  &lt 2 SPACE        &kp ENTER      &lt 3 LANGUAGE_1                                             &kp LA(LG(B))
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        layer1 {
            bindings = <
&kp C_BRI_DN    &kp C_BRI_UP      &kp C_VOL_DN      &kp C_VOL_UP      &kp LG(LS(NUMBER_4))                    &none         &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &none
&kp LG(A)       &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LA(LG(RIGHT))     &none      &none  &none         &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &none
&kp LEFT_SHIFT  &none             &kp LG(C)         &kp LG(V)         &kp LA(LG(T))         &none      &none  &none         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp RIGHT_SHIFT
&none           &none             &none             &none             &none                 &none      &none  &kp NUMBER_0                                            &none
            >;
        };

        layer2 {
            bindings = <
&kp NON_US_BACKSLASH  &kp GRAVE    &kp LG(LA(PIPE))  &none       &none                              &kp EQUAL      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SQT        &kp DOUBLE_QUOTES
&kp EXCLAMATION       &kp AT_SIGN  &kp HASH          &kp DOLLAR  &kp PERCENT  &none      &none      &kp PLUS       &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SEMICOLON  &kp COLON
&kp PIPE              &none        &kp LCTRL         &none       &kp TILDE    &none      &none      &kp ASTERISK   &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp AMPERSAND  &kp QUESTION
&none                 &none        &none             &none       &none        &none      &kp ENTER  &kp RIGHT_GUI                                                              &none
            >;
        };

        layer3 {
            bindings = <
&kp ESCAPE            &kp LG(W)         &none             &kp LG(R)           &kp LG(T)                                 &kp LG(LA(LEFT))    &kp LC(LEFT_ARROW)  &kp UP_ARROW      &kp LC(RIGHT_ARROW)  &kp LG(LA(RIGHT))
&kp LG(A)             &kp LG(S)         &kp LEFT_ALT      &mt LEFT_GUI LG(F)  &kp LCTRL         &none        &none      &kp LG(LEFT_ARROW)  &kp LEFT_ARROW      &kp DOWN_ARROW    &kp RIGHT            &kp LG(RIGHT)
&mt LEFT_SHIFT LG(Z)  &kp LG(X)         &kp LG(C)         &kp LG(V)           &kp LG(B)         &none        &none      &kp LG(LS(DOWN))    &kp LG(LS(V))       &kp LG(UP_ARROW)  &none                &kp LC(K)
&kp LG(NUMBER_5)      &kp LG(NUMBER_4)  &kp LG(NUMBER_3)  &kp LG(NUMBER_2)    &kp LG(NUMBER_1)  &kp TAB      &kp ENTER  &none                                                                          &none
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        layer4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                        &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &mkp MB1  &trans  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &mkp MB1      &trans  &trans                              &trans
            >;
        };

        layer5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LG(Z) LG(LS(Z))>;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans     &trans      &studio_unlock  &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kt KP_N4  &trans      &bootloader     &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans     &trans      &trans          &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
